# Copy to .env.local (git ignores it) and fill in. run-app.cmd reads it.

# Clerk development instance (docs/deploy.md#sign-in-with-clerk): API keys page of the dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# The instance's Frontend API URL, e.g. https://your-app-12.clerk.accounts.dev
CLERK_ISSUER=https://your-app-12.clerk.accounts.dev

# The email you sign in with; that account is the Admin (comma-separate several).
ADMIN_EMAILS=you@example.com

# The API's port on this machine (default 8000).
API_PORT=8000

# Grading written answers. The Claude Code CLI on this machine grades by default: sign it in
# with `claude` then /login, or put a token from `claude setup-token` here.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Encrypts the LLM keys Learners save in Settings (NVIDIA Nemotron). Make one with
#   uv run --directory api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it no key can be saved. Changing it makes saved keys unreadable.
LLM_KEY_SECRET=
