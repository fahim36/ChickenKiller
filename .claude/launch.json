{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "api", "uvicorn", "app.main:app", "--port", "8000"],
      "env": { "DATABASE_URL": "postgresql+psycopg://learning:learning@localhost:5433/learning" },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "env": { "API_URL": "http://localhost:8000" },
      "port": 3000
    }
  ]
}
