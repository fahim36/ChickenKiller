{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-prompt.schema.json",
  "$defs": {
    "FollowUp": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "scenario": {
          "minLength": 1,
          "title": "Scenario",
          "type": "string"
        },
        "rubric": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Rubric",
          "type": "array"
        }
      },
      "required": [
        "id",
        "scenario",
        "rubric"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a Question's content came from. A Source is for checking a Question; a Material is\nfor learning.",
      "properties": {
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "accessed": {
          "description": "The UTC date the Source was read, YYYY-MM-DD: in the run that wrote the Question (the content check allows today or yesterday for a new Question).",
          "format": "date",
          "title": "Accessed",
          "type": "string"
        },
        "claim": {
          "description": "The claim the Question relies on.",
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "publisher",
        "accessed",
        "claim"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "stack": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Stack",
      "type": "string"
    },
    "concept": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Concept",
      "type": "string"
    },
    "lesson": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Lesson",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "scenario": {
      "minLength": 1,
      "title": "Scenario",
      "type": "string"
    },
    "rubric": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Rubric",
      "type": "array"
    },
    "misconceptions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Misconceptions",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "follow_ups": {
      "items": {
        "$ref": "#/$defs/FollowUp"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Follow Ups",
      "type": "array"
    }
  },
  "required": [
    "id",
    "stack",
    "concept",
    "lesson",
    "version",
    "scenario",
    "rubric",
    "misconceptions",
    "sources",
    "follow_ups"
  ],
  "title": "InterviewPrompt",
  "type": "object"
}
