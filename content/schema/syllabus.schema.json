{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "syllabus.schema.json",
  "title": "Syllabus",
  "description": "One version of a Stack's Syllabus: its Weeks, Lessons, Milestones and Materials. Every id is permanent across versions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "stack", "materials", "weeks"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^v\\d{4}-\\d{2}-\\d{2}$" },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "weeks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/week" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "text": { "type": "string", "minLength": 1 },
    "material_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "type", "subject"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https://" },
        "type": { "enum": ["docs", "free", "video", "book", "paper", "tool", "paid", "platform"] },
        "subject": { "$ref": "#/$defs/text" }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "title", "goal", "deliverable", "interview_checks", "lessons", "milestones"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/text" },
        "goal": { "$ref": "#/$defs/text" },
        "deliverable": { "$ref": "#/$defs/text" },
        "interview_checks": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } },
        "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "topics", "exercise", "minutes", "materials"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "exercise": { "type": ["string", "null"] },
        "minutes": { "type": "integer", "minimum": 1 },
        "materials": { "$ref": "#/$defs/material_refs" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "minutes", "materials"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["build", "job-hunt"] },
        "minutes": { "type": "integer", "minimum": 1 },
        "materials": { "$ref": "#/$defs/material_refs" }
      }
    }
  }
}
