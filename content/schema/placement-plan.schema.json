{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "placement-plan.schema.json",
  "$defs": {
    "PlacementLesson": {
      "additionalProperties": false,
      "properties": {
        "lesson": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Lesson",
          "type": "string"
        },
        "essential_concepts": {
          "items": {
            "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Essential Concepts",
          "type": "array"
        },
        "count": {
          "enum": [
            5,
            10
          ],
          "title": "Count",
          "type": "integer"
        },
        "questions": {
          "items": {
            "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 5,
          "title": "Questions",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "lesson",
        "essential_concepts",
        "count",
        "questions",
        "rationale"
      ],
      "title": "PlacementLesson",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "stack": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Stack",
      "type": "string"
    },
    "week": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Week",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "reviewed_by": {
      "minLength": 1,
      "title": "Reviewed By",
      "type": "string"
    },
    "lessons": {
      "items": {
        "$ref": "#/$defs/PlacementLesson"
      },
      "minItems": 1,
      "title": "Lessons",
      "type": "array"
    }
  },
  "required": [
    "stack",
    "week",
    "version",
    "reviewed_by",
    "lessons"
  ],
  "title": "PlacementPlan",
  "type": "object"
}
