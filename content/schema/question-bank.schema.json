{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-bank.schema.json",
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-h]$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Concept",
      "type": "object"
    },
    "ModelAnswer": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "key_points": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Key Points",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "key_points"
      ],
      "title": "ModelAnswer",
      "type": "object"
    },
    "MultipleChoiceQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "concept": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Concept",
          "type": "string"
        },
        "type": {
          "const": "multiple_choice",
          "title": "Type",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        },
        "answer": {
          "pattern": "^[a-h]$",
          "title": "Answer",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "materials": {
          "description": "IDs of Materials in this Syllabus.",
          "items": {
            "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Materials",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "concept",
        "type",
        "prompt",
        "choices",
        "answer",
        "explanation",
        "materials"
      ],
      "title": "MultipleChoiceQuestion",
      "type": "object"
    },
    "WrittenQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "concept": {
          "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Concept",
          "type": "string"
        },
        "type": {
          "const": "written",
          "title": "Type",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "model_answer": {
          "$ref": "#/$defs/ModelAnswer"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "materials": {
          "description": "IDs of Materials in this Syllabus.",
          "items": {
            "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Materials",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "concept",
        "type",
        "prompt",
        "model_answer",
        "explanation",
        "materials"
      ],
      "title": "WrittenQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "All pre-written Questions for one Lesson. Questions testing the same Concept are siblings.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson_id": {
      "description": "Permanent ID: lowercase words joined by hyphens. It never changes across Syllabus versions, so Learner progress can be keyed by it.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Lesson Id",
      "type": "string"
    },
    "concepts": {
      "items": {
        "$ref": "#/$defs/Concept"
      },
      "minItems": 1,
      "title": "Concepts",
      "type": "array"
    },
    "questions": {
      "items": {
        "discriminator": {
          "mapping": {
            "multiple_choice": "#/$defs/MultipleChoiceQuestion",
            "written": "#/$defs/WrittenQuestion"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MultipleChoiceQuestion"
          },
          {
            "$ref": "#/$defs/WrittenQuestion"
          }
        ]
      },
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "lesson_id",
    "concepts",
    "questions"
  ],
  "title": "Question Bank",
  "type": "object"
}
